<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.yoss.thread.control">
   <children>
      <Label text="Contar número de clics" />
      <TextField fx:id="txtClics" alignment="CENTER" editable="false" text="0" prefWidth="200.0" maxWidth="250.0" />
      <Button fx:id="btnContar" text="¡Contar!" onAction="#btnContarClick" />
      
      <Label text="Esperar 10 segundos" />
      <ProgressBar fx:id="pgbProgreso" prefWidth="250.0" progress="0.0" />
      <Button fx:id="btnEsperar" text="¡Esperar!" onAction="#btnEsperarClick" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
